<http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIII> rdf:type owl:NamedIndividual ,
                                                                           <http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass> ;
                                                                  rdfs:comment "MDR risk class III: highest risk devices, including implantables and life-sustaining devices."@en ;
