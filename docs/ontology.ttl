                                                                         <http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass> ;
                                                                rdfs:label "Class B"@en ,
                                                                           "IVDR risk class B: moderate risk IVD devices, such as self-test blood glucose monitors."@en .


