                                                                         <http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass> ;
                                                                rdfs:comment "IVDR risk class A: lowest risk IVD devices, such as general laboratory instruments."@en ;
                                                                rdfs:label "Class A"@en .


