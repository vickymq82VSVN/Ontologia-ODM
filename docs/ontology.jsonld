  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A legal entity that manufactures or fully refurbishes a medical device and is responsible for its compliance with applicable regulations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Manufacturer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid4"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "A medical device registered in the EUDAMED catalogue under MDR or IVDR regulations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Medical Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid5"
  }, {
    "@id" : "_:genid6"
  }, {
    "@id" : "_:genid7"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/NearMissIncident",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An event that did not result in patient harm but could have done so under different circumstances."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Near Miss Incident"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RSK-001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Risk of complete loss of electrical function leading to device shutdown (IMDRF code A0101)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Device failure - electrical"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RSK-003",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Risk of thrombus formation on device surface causing embolic events (IMDRF code A0201)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Thrombosis - device-related"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RSK-010",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Risk of software bug causing incorrect dosing, alarming or therapy delivery (IMDRF code A0502)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Software malfunction"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RSK-015",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Risk of IVD test failing to detect target condition in affected individual (IMDRF code B0102)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "False negative result"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Recall",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A field safety corrective action involving the removal or return of affected devices from the market or from users."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Recall"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RegulatoryFramework",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The European regulatory framework applicable to a device: MDR (EU 2017/745) or IVDR (EU 2017/746)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Regulatory Framework"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An identified risk associated with a medical device, categorised according to the IMDRF nomenclature."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid8"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The risk classification assigned to a medical device based on its intended purpose and associated risks."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Class"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The category of a risk, such as malfunction risk, injury risk, infection risk or diagnostic risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Risk Type"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SafetyAlert",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A safety communication issued by a manufacturer to healthcare professionals warning about risks associated with a device."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Safety Alert"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SelfTestDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An IVD device intended for use by lay persons to perform testing on themselves, such as a glucose monitor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Self Test Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InVitroDiagnosticDevice"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SeriousIncident",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An incident that directly or indirectly led to death, serious deterioration in health, or serious public health threat."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Serious Incident"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SingleUseDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A device intended to be used on one individual during a single procedure and then discarded."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Single Use Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/UserNotice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A written notice sent to users or patients providing updated instructions or warnings about a device."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "User Notice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"
  } ]
