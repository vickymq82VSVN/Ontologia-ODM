    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "MDR risk class III: highest risk devices, including implantables and life-sustaining devices."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class III"
  } ]
