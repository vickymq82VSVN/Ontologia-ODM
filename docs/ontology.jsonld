  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has Risk Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a risk to its category or type according to the IMDRF classification."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has Risk Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/imdrfCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The standardised code assigned to the risk according to the IMDRF nomenclature."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
