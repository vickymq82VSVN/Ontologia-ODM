  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "La ODM es una ontología de dominio que representa información sobre dispositivos médicos que se comercializan en Europa.  Incluye información sobre dispositivos, fabricantes, riesgos, incidentes y correcciones de seguridad."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "Ontología de Dispositivos Médicos (ODM)"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "A medical device that requires an energy source other than that generated by the human body or gravity to operate."
  }, {
    "@language" : "en",
    "@value" : "Active Device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveImplant",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An implantable device that also depends on an energy source to function, such as a pacemaker or cochlear implant."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Active Implant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveDevice"
  }, {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableDevice"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassA",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "IVDR risk class A: lowest risk IVD devices, such as general laboratory instruments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class A"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassB",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class B"
  }, {
    "@language" : "en",
    "@value" : "IVDR risk class B: moderate risk IVD devices, such as self-test blood glucose monitors."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassC",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "IVDR risk class C: high risk IVD devices, such as HIV and cancer diagnostic tests."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class C"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassD",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "IVDR risk class D: highest risk IVD devices, such as blood screening tests for infectious diseases."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class D"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassI",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "MDR risk class I: lowest risk, generally non-invasive devices."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Class I"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIII",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
