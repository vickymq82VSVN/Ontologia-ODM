<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM#"
     xml:base="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM">
        <dc:creator xml:lang="en">Victoria Moyano Queipo</dc:creator>
        <dc:date xml:lang="en">27/04/2026</dc:date>
        <dc:description xml:lang="en">La ODM es una ontología de dominio que representa información sobre dispositivos médicos que se comercializan en Europa.  Incluye información sobre dispositivos, fabricantes, riesgos, incidentes y correcciones de seguridad.</dc:description>
        <dc:title xml:lang="en">Ontología de Dispositivos Médicos (ODM)</dc:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#sameAs -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#sameAs"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/addressesIncident -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/addressesIncident">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:comment xml:lang="en">Relates a field safety corrective action to the incident that triggered it.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses Incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType"/>
        <rdfs:comment xml:lang="en">Relates a medical device to its assigned risk class under MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">has Risk Class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass"/>
        <rdfs:comment xml:lang="en">Relates a risk to its category or type according to the IMDRF classification.</rdfs:comment>
        <rdfs:label xml:lang="en">has Risk Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/involvesDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Relates an incident to the specific medical device that was involved in the adverse event.</rdfs:comment>
        <rdfs:label xml:lang="en">involves Device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isAssociatedWithRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isAssociatedWithRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
        <rdfs:comment xml:lang="en">Relates an incident to the identified risk that caused or contributed to the adverse event.</rdfs:comment>
        <rdfs:label xml:lang="en">is Associated With Risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isLocatedIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isLocatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Country"/>
        <rdfs:comment xml:lang="en">Relates a manufacturer to the country where it is legally registered. This property is transitive.</rdfs:comment>
        <rdfs:label xml:lang="en">is Located In</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isManufacturedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isManufacturedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates a medical device to the manufacturer responsible for its production and regulatory compliance.</rdfs:comment>
        <rdfs:label xml:lang="en">is Manufactured By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isRegulatedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isRegulatedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">Relates a medical device to the regulatory framework (MDR or IVDR) under which it is authorised.</rdfs:comment>
        <rdfs:label xml:lang="en">is Regulated By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/authorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/authorizationNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The official authorisation number issued by the national competent authority to the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">authorization Number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/deviceId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unique identifier of the medical device in the EUDAMED catalogue (e.g. DEV-001).</rdfs:comment>
        <rdfs:label xml:lang="en">device Id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/deviceName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The commercial name of the medical device as registered in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">device Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/devicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/devicesAffected">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The number or description of device units affected by the FSCA.</rdfs:comment>
        <rdfs:label xml:lang="en">devices Affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/eudamedSRN -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/eudamedSRN">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Single Registration Number (SRN) assigned to the manufacturer in the EUDAMED system.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/eventDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/eventDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date on which the adverse event actually occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">event Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/fscaStatus -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/fscaStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The current status of the FSCA: Open or Closed.</rdfs:comment>
        <rdfs:label xml:lang="en">FSCA Status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasHighRiskFlag -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasHighRiskFlag">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag inferred by the reasoner indicating that the device has been involved in at least one serious incident and therefore presents a high risk flag.</rdfs:comment>
        <rdfs:label xml:lang="en">has High Risk Flag</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/imdrfCode -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/imdrfCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The standardised code assigned to the risk according to the IMDRF nomenclature.</rdfs:comment>
        <rdfs:label xml:lang="en">IMDRF Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/incidentId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/incidentId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unique identifier of the incident report in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">incident Id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/incidentOutcome -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/incidentOutcome">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A description of the result or consequence of the incident for the patient or device.</rdfs:comment>
        <rdfs:label xml:lang="en">incident Outcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/intendedPurpose -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/intendedPurpose">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The intended use of the medical device as declared by the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">intended Purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isActive -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isActive">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag indicating whether the device requires an energy source to operate.</rdfs:comment>
        <rdfs:label xml:lang="en">is Active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isCriticalIncident -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isCriticalIncident">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag inferred by the reasoner indicating that the incident is associated with a risk of critical severity level.</rdfs:comment>
        <rdfs:label xml:lang="en">is Critical Incident</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isImplantable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag indicating whether the device is designed to be implanted in the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">is Implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isReusable -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isReusable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag indicating whether the device is designed for multiple uses.</rdfs:comment>
        <rdfs:label xml:lang="en">is Reusable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isUnderCorrectiveAction -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isUnderCorrectiveAction">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag inferred by the reasoner indicating that the device is currently subject to an active field safety corrective action (FSCA).</rdfs:comment>
        <rdfs:label xml:lang="en">is Under Corrective Action</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/manufacturerName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The full legal name of the manufacturer as registered with the competent authority.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/patientAge">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The age of the patient involved in the incident, if applicable.</rdfs:comment>
        <rdfs:label xml:lang="en">patient Age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/patientSex -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/patientSex">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The sex of the patient involved in the incident, if applicable.</rdfs:comment>
        <rdfs:comment xml:lang="en">patient Sex</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/reportDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date on which the incident was officially reported to EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">report Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/riskName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/riskName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The descriptive name of the identified risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/severity -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/severity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The severity level of the risk: Critical, Serious or Moderate.</rdfs:comment>
        <rdfs:label xml:lang="en">severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/udiDi -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/udiDi">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Unique Device Identifier - Device Identifier code assigned to the device.</rdfs:comment>
        <rdfs:label xml:lang="en">UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:label xml:lang="en">A medical device that requires an energy source other than that generated by the human body or gravity to operate.</rdfs:label>
        <rdfs:label xml:lang="en">Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveImplant -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An implantable device that also depends on an energy source to function, such as a pacemaker or cochlear implant.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Implant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Country -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Country">
        <rdfs:comment xml:lang="en">A country in which a manufacturer is registered or in which an incident has been reported.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/addressesIncident"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An action taken by a manufacturer to reduce a risk of death or serious deterioration associated with a device already on the market.</rdfs:comment>
        <rdfs:label xml:lang="en">Field Safety Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass"/>
        <rdfs:comment xml:lang="en">Risk classification under the In Vitro Diagnostic Regulation (EU 2017/746): Class A, B, C or D.</rdfs:comment>
        <rdfs:label xml:lang="en">IVDR Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ActiveImplant"/>
        <rdfs:comment xml:lang="en">A specific subtype of active implant requiring both energy and permanent implantation, such as a ventricular assist device.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device designed to be fully or partially introduced into the human body and intended to remain after the procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InSituCorrection -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InSituCorrection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:comment xml:lang="en">A corrective action performed on the device at its current location without requiring its return to the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">In Situ Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">A medical device used to perform tests on specimens taken from the human body, such as blood or tissue samples.</rdfs:comment>
        <rdfs:label xml:lang="en">In Vitro Diagnostic Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isAssociatedWithRisk"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/involvesDevice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A notified adverse event involving a medical device that has or could have led to patient harm.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass"/>
        <rdfs:comment xml:lang="en">Risk classification under the Medical Device Regulation (EU 2017/745): Class I, IIa, IIb or III.</rdfs:comment>
        <rdfs:label xml:lang="en">MDR Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isLocatedIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A legal entity that manufactures or fully refurbishes a medical device and is responsible for its compliance with applicable regulations.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isManufacturedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskClass"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/isRegulatedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RegulatoryFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">A medical device registered in the EUDAMED catalogue under MDR or IVDR regulations.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/NearMissIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/NearMissIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:comment xml:lang="en">An event that did not result in patient harm but could have done so under different circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Near Miss Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Recall -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Recall">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:comment xml:lang="en">A field safety corrective action involving the removal or return of affected devices from the market or from users.</rdfs:comment>
        <rdfs:label xml:lang="en">Recall</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RegulatoryFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RegulatoryFramework">
        <rdfs:comment xml:lang="en">The European regulatory framework applicable to a device: MDR (EU 2017/745) or IVDR (EU 2017/746).</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Risk">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/hasRiskType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An identified risk associated with a medical device, categorised according to the IMDRF nomenclature.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskClass">
        <rdfs:comment xml:lang="en">The risk classification assigned to a medical device based on its intended purpose and associated risks.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/RiskType">
        <rdfs:comment xml:lang="en">The category of a risk, such as malfunction risk, injury risk, infection risk or diagnostic risk</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SafetyAlert -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:comment xml:lang="en">A safety communication issued by a manufacturer to healthcare professionals warning about risks associated with a device.</rdfs:comment>
        <rdfs:label xml:lang="en">Safety Alert</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SelfTestDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SelfTestDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/InVitroDiagnosticDevice"/>
        <rdfs:comment xml:lang="en">An IVD device intended for use by lay persons to perform testing on themselves, such as a glucose monitor.</rdfs:comment>
        <rdfs:label xml:lang="en">Self Test Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SeriousIncident -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/Incident"/>
        <rdfs:comment xml:lang="en">An incident that directly or indirectly led to death, serious deterioration in health, or serious public health threat.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SingleUseDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/SingleUseDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">A device intended to be used on one individual during a single procedure and then discarded.</rdfs:comment>
        <rdfs:label xml:lang="en">Single Use Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/UserNotice -->


    <owl:Class rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/UserNotice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/FSCA"/>
        <rdfs:comment xml:lang="en">A written notice sent to users or patients providing updated instructions or warnings about a device.</rdfs:comment>
        <rdfs:label xml:lang="en">User Notice</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassA -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassA">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR risk class A: lowest risk IVD devices, such as general laboratory instruments.</rdfs:comment>
        <rdfs:label xml:lang="en">Class A</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassB -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassB">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"/>
        <rdfs:label xml:lang="en">Class B</rdfs:label>
        <rdfs:label xml:lang="en">IVDR risk class B: moderate risk IVD devices, such as self-test blood glucose monitors.</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassC -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassC">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR risk class C: high risk IVD devices, such as HIV and cancer diagnostic tests.</rdfs:comment>
        <rdfs:label xml:lang="en">Class C</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassD -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassD">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/IVDRRiskClass"/>
        <rdfs:comment xml:lang="en">IVDR risk class D: highest risk IVD devices, such as blood screening tests for infectious diseases.</rdfs:comment>
        <rdfs:label xml:lang="en">Class D</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassI -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassI">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"/>
        <rdfs:comment xml:lang="en">MDR risk class I: lowest risk, generally non-invasive devices.</rdfs:comment>
        <rdfs:label xml:lang="en">Class I</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIII -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIII">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"/>
        <rdfs:comment xml:lang="en">MDR risk class III: highest risk devices, including implantables and life-sustaining devices.</rdfs:comment>
        <rdfs:label xml:lang="en">Class III</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIIa -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIIa">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"/>
        <rdfs:comment xml:lang="en">MDR risk class IIa: medium risk devices requiring notified body involvement.</rdfs:comment>
        <rdfs:label xml:lang="en">Class IIa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIIb -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/ClassIIb">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MDRRiskClass"/>
        <rdfs:comment xml:lang="en">MDR risk class IIb: higher medium risk devices with more stringent conformity assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Class IIb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-001 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-001">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Instance of ImplantableActiveDevice representing the HeartMate 3 Left Ventricular Assist Device by Medtronic.</rdfs:comment>
        <rdfs:label xml:lang="en">HeartMate 3 LVAD</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-002 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-002">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Instance of ActiveImplant representing the Micra AV leadless cardiac pacemaker by Medtronic.</rdfs:comment>
        <rdfs:label xml:lang="en">Micra AV Transcatheter Pacing System</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-003 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-003">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">nstance of ImplantableDevice representing the Portico TAVI system by Abbott.</rdfs:comment>
        <rdfs:label xml:lang="en">Portico Transcatheter Heart Valve</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-004 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-004">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Instance of ImplantableDevice representing the SYNERGY drug-eluting coronary stent by Boston Scientific.</rdfs:comment>
        <rdfs:label xml:lang="en">SYNERGY Stent System</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-005 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-005">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Instance of ActiveImplant representing the ACUITY X4 cardiac resynchronization lead by Boston Scientific.</rdfs:comment>
        <rdfs:label xml:lang="en">ACUITY X4 Quadripolar LV Lead</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-007 -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-007">
        <rdf:type rdf:resource="http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/MedicalDevice"/>
        <rdfs:comment xml:lang="en">Instance of ActiveDevice representing the ACUSON Sequoia diagnostic ultrasound system by Siemens Healthineers.</rdfs:comment>
        <rdfs:label xml:lang="en">ACUSON Sequoia Ultrasound</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/vicky/ontologies/2026/3/ODM/DEV-016 -->


